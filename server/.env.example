# ───── Core ─────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/events_dev
# Public URLs (used in emails, invitations, sitemap and CORS)
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
# 32+ random characters: `openssl rand -hex 32`
APP_SECRET=
# Cookies: set COOKIE_SECURE=true behind HTTPS (automatic in production)
COOKIE_SECURE=
COOKIE_DOMAIN=
SESSION_TTL_HOURS=168
TRUST_PROXY=1
JOBS_ENABLED=true
LOG_LEVEL=info

# ───── Media storage ─────
# local (development only) | cloudinary (production)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ───── Email ─────
# none (messages are logged as SKIPPED, never reported as sent) | smtp | resend
EMAIL_PROVIDER=none
EMAIL_FROM="Maison Aurelle <hello@yourdomain.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
RESEND_API_KEY=

# ───── WhatsApp (optional, Meta WhatsApp Cloud API) ─────
WHATSAPP_PROVIDER=none
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ───── Payments ─────
# sandbox (local/test only; refused in production) | razorpay
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ───── Spam protection (optional Cloudflare Turnstile) ─────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ───── AI assistance (optional; suggestions are always reviewed by staff) ─────
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
